# Copy to .env and fill in. Never commit .env.

# Moonetix dashboard: Offerwalls, your offerwall, Integration
MOONETIX_APP_ID=your-app-id
MOONETIX_LINK_SALT=your-link-hash-salt
# Moonetix dashboard: Postback page
MOONETIX_POSTBACK_KEY=your-postback-secret-key

# Signs the demo session cookie. A long random string.
SESSION_SECRET=replace-with-a-long-random-string

# Optional
PORT=3000
HOST=127.0.0.1
DATABASE_PATH=./data/app.sqlite
# NODE_ENV=production   adds the Secure flag to the session cookie (needs https)
